{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knc-twin.kernel/1",
  "title": "knc-twin kernel (normalized instruction records)",
  "description": "A small kernel as per-context instruction streams with initial state, expected outputs, scenarios and numerical policy. Records are validated against the ISA table in scripts/knc_model/isa.py, not against machine encodings. See references/input-format.md.",
  "type": "object",
  "required": ["schema", "streams"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "knc-twin.kernel/1"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "notes": {"type": ["string", "array"]},
    "representation": {"enum": ["normalized-records", "gas-att-subset"], "description": "optional declaration; derived from the streams"},
    "unit_of_work": {
      "type": "object", "required": ["count"],
      "properties": {"description": {"type": "string"}, "count": {"type": "integer", "minimum": 1, "description": "units completed by one run of all streams; predicted cycles are also reported per unit"}}
    },
    "numerical_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rounding": {"enum": ["rn", "rd", "ru", "rz"], "default": "rn"},
        "ftz": {"type": "boolean", "default": false},
        "daz": {"type": "boolean", "default": false},
        "ftz_rule": {"enum": ["tiny", "tiny_and_inexact"], "default": "tiny"},
        "nan_compare": {"enum": ["any_nan", "bits"], "default": "any_nan"},
        "reciprocal_tables": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "vrcp23ps": {"$ref": "#/definitions/reciprocal_table"},
            "vrsqrt23ps": {"$ref": "#/definitions/reciprocal_table"}
          }
        }
      }
    },
    "memory_default": {"type": ["integer", "null"], "description": "byte value returned by reads of uninitialized memory; absent = such a read is invalid_input"},
    "max_steps": {"type": "integer", "minimum": 1, "default": 200000},
    "init": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "heap": {
          "type": "object", "required": ["addr", "size"], "additionalProperties": false,
          "description": "Shared bump-allocator scenario region; must be disjoint from all other memory. Addresses align to 64 bytes and free never reuses storage.",
          "properties": {
            "addr": {"type": ["integer", "string"]},
            "size": {"type": ["integer", "string"]}
          }
        },
        "memory": {"type": "array", "items": {"$ref": "#/definitions/memblock"}},
        "registers": {"$ref": "#/definitions/registers", "description": "applies to every stream; a stream's own init overrides"}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "memory": {"type": "array", "items": {"$ref": "#/definitions/memblock"}},
        "registers": {"type": "object", "description": "context index (string) -> registers", "additionalProperties": {"$ref": "#/definitions/registers"}}
      }
    },
    "streams": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "context": {"type": "integer", "minimum": 0, "maximum": 3},
          "init": {"type": "object", "properties": {"registers": {"$ref": "#/definitions/registers"}}},
          "expected": {"type": "object", "properties": {"registers": {"$ref": "#/definitions/registers"}}},
          "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/record"}},
          "asm": {"type": ["string", "array"], "description": "GAS AT&T subset text instead of instructions"},
          "asm_file": {"type": "string", "description": "path (relative to the kernel file) of GAS AT&T subset text"}
        },
        "oneOf": [{"required": ["instructions"]}, {"required": ["asm"]}, {"required": ["asm_file"]}]
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "memory": {
          "oneOf": [
            {"type": "object", "required": ["type", "level"], "properties": {"type": {"const": "fixed_level"}, "level": {"$ref": "#/definitions/level"}}},
            {"type": "object", "required": ["type", "default"], "properties": {"type": {"const": "classified"}, "default": {"$ref": "#/definitions/level"},
              "ranges": {"type": "array", "items": {"type": "object", "required": ["start", "end", "level"], "properties": {"start": {"$ref": "#/definitions/int"}, "end": {"$ref": "#/definitions/int"}, "level": {"$ref": "#/definitions/level"}}}}}},
            {"type": "object", "required": ["type"], "properties": {"type": {"const": "line_tracking"}, "cold_level": {"$ref": "#/definitions/level", "default": "memory"},
              "hardware_prefetcher": {"const": "off"},
              "warm": {"type": "array", "items": {"type": "object", "required": ["start", "end", "level"], "properties": {"start": {"$ref": "#/definitions/int"}, "end": {"$ref": "#/definitions/int"}, "level": {"$ref": "#/definitions/level"}}}}}}
          ]
        },
        "branch": {
          "type": "object", "required": ["type"],
          "properties": {"type": {"enum": ["all_predicted", "all_mispredicted", "exit_mispredicted", "ids_mispredicted"]}, "ids": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "loop": {
      "type": "object", "required": ["label"],
      "properties": {
        "label": {"type": "string"},
        "trip_count": {"type": "integer", "minimum": 1, "description": "required for static traces; functional traces discover it"},
        "back_branch": {"type": "string", "description": "id of the backward branch; default: the last branch to the label"},
        "memory_carried": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "distance": {"type": "integer", "minimum": 1}}}}
      }
    }
  },
  "definitions": {
    "reciprocal_table": {
      "type": "object", "required": ["file", "entries", "status", "source", "exponent_scaling_verified"],
      "properties": {
        "file": {"type": "string", "description": "basename under fixtures/tables"},
        "entries": {"enum": [1024, 8388608, 16777216]},
        "status": {"enum": ["measured", "synthetic"]},
        "source": {"type": "string"},
        "exponent_scaling_verified": {"const": true}
      }
    },
    "int": {"type": ["integer", "string"], "description": "integer, or a decimal/hex string such as \"0x1000\""},
    "level": {"enum": ["l1", "l2", "memory"]},
    "memblock": {
      "type": "object", "required": ["addr"],
      "properties": {
        "addr": {"$ref": "#/definitions/int"},
        "f32": {"type": "array", "items": {"type": ["number", "string"]}, "description": "exactly representable numbers, or bit strings 0x..., or nan/inf/-inf/-0.0"},
        "f64": {"type": "array", "items": {"type": ["number", "string"]}},
        "u32": {"type": "array", "items": {"$ref": "#/definitions/int"}},
        "i32": {"type": "array", "items": {"$ref": "#/definitions/int"}},
        "u64": {"type": "array", "items": {"$ref": "#/definitions/int"}},
        "u8": {"type": "array", "items": {"$ref": "#/definitions/int"}},
        "fill": {"type": "object", "properties": {"count": {"type": "integer"}, "f32": {}, "f64": {}, "u32": {}, "i32": {}, "u64": {}, "u8": {}}}
      }
    },
    "registers": {
      "type": "object",
      "description": "rax..r15: integer; zmm0-31: {f32:[16]} | {u32:[16]} | {f64:[8]} | {u64:[8]} | {f32_broadcast: x} | {u32_broadcast: x} | {f64_broadcast: x} | hex string of 64 bytes; k0-k7: integer (16 bits); flags: {ZF,SF,CF,OF: 0|1}",
      "additionalProperties": true
    },
    "operand": {
      "oneOf": [
        {"type": "string", "description": "register name (rax, eax, zmm3, k1), label (branch target), or immediate as decimal/hex string"},
        {"type": "integer", "description": "immediate"},
        {"type": "object", "properties": {"imm": {"$ref": "#/definitions/int"}}, "required": ["imm"]},
        {"type": "object", "description": "memory operand",
         "properties": {"base": {"type": "string"}, "index": {"type": "string"}, "vindex": {"type": "string", "description": "zmm index register for gather/scatter"}, "scale": {"enum": [1, 2, 4, 8]}, "disp": {"$ref": "#/definitions/int"}, "broadcast": {"enum": ["1to16", "1to8"]}},
         "additionalProperties": false}
      ]
    },
    "record": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "op": {"type": "string", "description": "mnemonic from the supported table (knc_twin.py capabilities)"},
        "ops": {"type": "array", "items": {"$ref": "#/definitions/operand"}, "description": "Intel operand order: destination first"},
        "mask": {"type": "string", "pattern": "^k[0-7]$", "description": "write mask (merge semantics); gather: completion mask"},
        "rounding": {"enum": ["rn", "rd", "ru", "rz"], "description": "per-instruction rounding override (vector FP only)"},
        "label": {"type": "string"},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "ordered labels for jmp_table"},
        "width": {"enum": [32, 64], "description": "scalar operand width when no register implies it"},
        "encoding": {"type": "object", "properties": {"bytes": {"type": "integer"}, "disp32": {"type": "boolean"}, "disp": {"type": "boolean"}, "imm": {"type": "boolean"}}, "description": "optional hints for the R02 p.56 pairing rules"},
        "deps": {"type": "array", "items": {"type": "string"}, "description": "extra explicit dependencies on instruction ids"},
        "x87_deps": {"type": "array", "items": {"type": "string"}},
        "addr": {"type": "object", "required": ["start"], "properties": {"start": {"$ref": "#/definitions/int"}, "stride": {"$ref": "#/definitions/int"}}, "description": "static-trace address description: start + n*stride for the n-th dynamic instance"},
        "lines": {"type": "integer", "minimum": 1, "description": "static-trace hint: distinct cache lines touched by a gather"},
        "comment": {"type": "string"}
      }
    }
  }
}
