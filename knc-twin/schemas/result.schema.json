{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knc-twin.result/1",
  "title": "knc-twin result",
  "type": "object",
  "required": ["schema", "result_type", "status", "engine_version", "timestamp_utc", "invocation", "artifacts", "assumptions", "unsupported"],
  "properties": {
    "schema": {"const": "knc-twin.result/1"},
    "result_type": {"enum": ["functional", "timing_prediction", "analytical_bound", "analytical_scenario_estimate", "imported_native_measurement", "capabilities", "comparison", "native_request", "validation", "selftest", "search"]},
    "status": {"enum": ["ok", "invalid_input", "unsupported", "missing_parameter", "budget_exhausted", "functional_mismatch", "needs_parameters", "incompatible", "error"]},
    "engine_version": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "invocation": {"type": "object", "properties": {"argv": {"type": "array"}, "cwd": {"type": "string"}, "python": {"type": "string"}, "command": {"type": "string"}}},
    "profile": {"type": ["object", "null"], "properties": {"id": {}, "version": {}, "hash": {"type": "string"}, "synthetic": {"type": "boolean"}, "chain": {}, "calibration": {}, "native_measurement_ids": {}, "parameter_status_counts": {}}},
    "calibration_status": {"type": ["object", "null"]},
    "input": {"type": ["object", "null"], "description": "path, hash_sha256 and the kernel description"},
    "representation_evaluated": {"type": ["string", "null"]},
    "scale": {"type": ["string", "null"]},
    "functional_check": {"type": "object", "properties": {"status": {"enum": ["ok", "mismatch", "not_specified", "not_run"]}, "mismatches": {"type": "array"}, "checked": {"type": "integer"}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unsupported": {"type": "array"},
    "prediction": {"type": ["object", "null"], "description": "present only with status ok; cycles, bounds or scenario estimates, labeled by kind"},
    "limiting_constraints": {"type": "array"},
    "parameters_used": {"type": "object", "description": "profile parameters consulted by this run with value and status"},
    "message": {"type": "string"},
    "error_details": {"type": ["string", "null"]},
    "partial": {"type": "object", "description": "present only for budget_exhausted; never a result"},
    "artifacts": {"type": "object", "properties": {"output_dir": {}, "result_json": {}, "summary_md": {}}},
    "python_execution_seconds": {"type": ["number", "null"], "description": "host wall time; unrelated to predicted KNC cycles"}
  }
}
