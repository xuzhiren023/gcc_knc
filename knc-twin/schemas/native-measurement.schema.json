{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knc-twin.native-measurement/1",
  "title": "knc-twin native measurement (filled in by the hardware queue operator)",
  "type": "object",
  "required": ["schema", "job_id", "measured_utc", "card_profile", "results"],
  "properties": {
    "schema": {"const": "knc-twin.native-measurement/1"},
    "request_hash_sha256": {"type": "string", "description": "request.json's request_hash_sha256; import-native rejects a mismatch"},
    "job_id": {"type": "string", "description": "queue job identifier (e.g. card_run job id)"},
    "measured_utc": {"type": "string"},
    "card_profile": {"type": "string", "description": "profile id of the card measured"},
    "environment": {"type": "object", "properties": {"mpss": {"type": "string"}, "clock_policy": {"type": "string"}, "clock_khz": {"type": "integer"}, "toolchain": {"type": "string"}, "placement": {"type": "string"}}},
    "results": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["threads_per_core", "ticks_per_unit_per_thread"],
        "properties": {
          "threads_per_core": {"type": "integer", "minimum": 1, "maximum": 4},
          "ticks_per_unit_per_thread": {"type": "number"},
          "ticks_per_call_per_thread": {"type": "number"},
          "spread_pct": {"type": "number"},
          "groups": {"type": "integer"},
          "batches": {"type": "integer"},
          "check": {"enum": ["ok", "mismatch", "not_specified"]},
          "raw_output": {"type": "string", "description": "path of the driver's JSON lines"}
        }}
    },
    "parameters": {
      "type": "array",
      "description": "only for calibration microbenchmarks that isolate one parameter; becomes a profile overlay with status measured",
      "items": {"type": "object", "required": ["name", "value", "unit"], "properties": {"name": {"type": "string"}, "value": {}, "unit": {"type": "string"}, "note": {"type": "string"}, "uncertainty": {"type": "string"}}}
    },
    "notes": {"type": "string"}
  }
}
