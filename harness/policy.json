{
  "wip_limit": 1,
  "max_review_rounds": 2,
  "note_max_chars": 600,
  "ticket_body_max_lines": 80,
  "session_timeout_minutes": 90,
  "budgets": {
    "light":    {"tool_calls": 60,  "test_runs": 6,  "sessions": 2, "input_tokens": 2000000,  "changed_lines": 200, "new_test_files": 2, "effort": "low"},
    "standard": {"tool_calls": 150, "test_runs": 15, "sessions": 3, "input_tokens": 6000000,  "changed_lines": 500, "new_test_files": 4, "effort": "medium"},
    "deep":     {"tool_calls": 300, "test_runs": 25, "sessions": 4, "input_tokens": 12000000, "changed_lines": 800, "new_test_files": 8, "effort": "high"}
  },
  "test_to_code_ratio": 1.5,
  "test_ratio_min_lines": 100,
  "protected_paths": ["tests/acceptance/", "docs/adr/", "harness/", ".codex/", "work/tickets/", "docs/COLLABORATION.md", "AGENTS.md", "CLAUDE.md"],
  "test_paths": ["tests/"],
  "hash_in_diff": "hashlib|file_digest|\\bsha(1|256|512)(sum)?\\b|\\bmd5(sum)?\\b|Get-FileHash|certutil",
  "receipt_files": "(?i)(receipt|attestation|evidence|provenance|checksums?|sha256sums?)[^/]*$",
  "hook_rules": [
    {
      "name": "hash",
      "command": "(sha\\d+sum|md5sum|b2sum|cksum|certutil|Get-FileHash)\\b",
      "anywhere": "hashlib|file_digest",
      "reason": "Hashing is not part of this project's process. Git already identifies content."
    },
    {
      "name": "push-merge",
      "command": "git\\s+(push|merge)\\b",
      "reason": "The tech lead merges after review, and the owner controls pushes."
    },
    {
      "name": "card",
      "command": "(ssh|scp|micnativeloadex)\\b",
      "reason": "Use the card only through tools/card_run."
    },
    {
      "name": "raw-build-test",
      "command": "(make|\\./configure|configure|runtest|pytest|ctest|ninja)\\b|python\\S*\\s+-m\\s+(unittest|pytest)\\b",
      "reason": "Run builds and tests through: python tools/run.py --name <name> -- <command>. It keeps output short and skips repeats."
    },
    {
      "name": "dump-log",
      "command": "(cat|type|more|Get-Content)\\b[^;|&]*\\.(log|sum)\\b(?![^;|&]*-Tail)",
      "reason": "Do not read whole logs. Use rg for the error, or tail -n 50."
    }
  ],
  "test_run_pattern": "tools[/\\\\]run\\.py\\s+--name\\s+t\\S*|tools[/\\\\]check",
  "full_tier_pattern": "tools[/\\\\]check\\S*\\s+[^;|&]*\\b(t[456])\\b",
  "wrappers": "tools[/\\\\](run|card_run)(\\.py)?\\b",
  "exempt": "tools[/\\\\]pm\\.py|git\\s+(add|commit|status|diff|log|show)\\b"
}
