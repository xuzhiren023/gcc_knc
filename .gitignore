# Build trees and installs
/build/
/install/
/.tools/
/.work/

# Generated test output (keep small summaries in tests/baseline/)
*.o
*.s
!/tests/**/*.s
!/tools/s12_06_controls.S
*.mic
*.exe
*.sum
*.log
*.su
/tests/out/

# Restricted or bulky inputs never enter git
/toolchain/sysroot/
/vendor-docs/

# Local tool state
__pycache__/
*.pyc

# Owner-supplied card connection settings (S0-04)
/config/card.local.json

# GCC dump and opt-record files from torture and T1 runs (S6-04 committed some by accident)
*.c.[0-9][0-9][0-9][rtil].*
*.opt-record.json.gz
/tmp*/
