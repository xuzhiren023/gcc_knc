#!/usr/bin/env python3
"""Check the S0-01 shared bootstrap tools: python3 tools/doctor."""
import json
import os
from pathlib import Path
import subprocess
import sys


def check(manifest, root):
    env = os.environ.copy()
    env["PATH"] = os.pathsep.join(str(root / p) for p in
                                  ("cross/bin", "cygwin/bin")) + os.pathsep + env.get("PATH", "")
    failed = False
    for tool in manifest["tools"]:
        path = root / tool["path"]
        required = tool.get("required", True)
        if not path.is_file():
            print("%s %s: %s (%s)" % ("MISSING" if required else "ABSENT",
                  tool["name"], path, tool["role"]))
            failed |= required
            continue
        try:
            result = subprocess.run([str(path), *tool.get("args", ["--version"])],
                                    env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, errors="replace", timeout=15)
            output = result.stdout.strip()
            if result.returncode or not output:
                raise ValueError("exit %s: %s" % (result.returncode, output[:300]))
            if tool["version"] and tool["version"] not in output:
                raise ValueError("expected %s; got %s" % (tool["version"], output[:300]))
            print("OK %s: %s" % (tool["name"], output.splitlines()[0]))
            if tool["name"] in ("k1om-mpss-linux-gcc", "k1om-mpss-linux-g++",
                                "k1om-mpss-linux-gfortran"):
                for query in ("-print-prog-name=as", "-print-prog-name=ld", "-print-sysroot"):
                    answer = subprocess.run([str(path), query], env=env,
                                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                            text=True, errors="replace", timeout=15)
                    value = answer.stdout.strip()
                    if answer.returncode or not value:
                        raise ValueError("%s failed: %s" % (query, value))
                    if os.name == "nt" and value.startswith("/"):
                        value = subprocess.check_output(
                            [str(root / "cygwin/bin/cygpath.exe"), "-w", value],
                            env=env, text=True, timeout=15).strip()
                    resolved = Path(value).resolve()
                    try:
                        resolved.relative_to(root.resolve())
                    except ValueError:
                        raise ValueError("%s resolves outside shared toolchain: %s; "
                                         "run python tools/toolchain.py rebuild" % (query, value))
                    if query == "-print-sysroot" and resolved != (root / manifest["sysroot"]).resolve():
                        raise ValueError("%s is not the card-derived sysroot: %s; "
                                         "run python tools/toolchain.py rebuild" % (query, value))
                    print("OK %s %s: %s" % (tool["name"], query, value))
        except (OSError, subprocess.TimeoutExpired, ValueError) as error:
            print("FAILED %s: %s: %s" % (tool["name"], path, error))
            failed = True
    sysroot = root / manifest["sysroot"]
    sysroot_failed = False
    for relative in ("usr/include", "lib64", "lib", "usr/lib"):
        if not (sysroot / relative).is_dir():
            print("MISSING sysroot directory: %s; run python tools/toolchain.py sysroot" %
                  (sysroot / relative))
            sysroot_failed = True
    for name in ("crt1.o", "crti.o", "crtn.o", "libc.so", "libc_nonshared.a",
                 "libpthread_nonshared.a", "Scrt1.o", "gcrt1.o", "Mcrt1.o",
                 "libm.so", "libpthread.so", "libdl.so", "librt.so", "libcrypt.so",
                 "libutil.so", "libresolv.so", "libnsl.so", "libanl.so", "libthread_db.so"):
        if not (sysroot / "usr/lib64" / name).is_file():
            print("MISSING sysroot development file: %s; run python tools/toolchain.py sysroot" %
                  (sysroot / "usr/lib64" / name))
            sysroot_failed = True
    failed |= sysroot_failed
    print("%s sysroot: %s" % ("FAILED" if sysroot_failed else "OK", sysroot))
    return int(failed)


def main():
    checkout = Path(__file__).resolve().parents[1]
    # pm.py puts ticket worktrees under the main checkout's .work directory.
    project = checkout.parent.parent if checkout.parent.name == ".work" else checkout
    try:
        manifest = json.loads((checkout / "toolchain/manifest.json").read_text())
        return check(manifest, project / manifest["root"])
    except (OSError, ValueError, KeyError) as error:
        print("FAILED toolchain manifest: %s" % error)
        return 1


if __name__ == "__main__":
    sys.exit(main())
